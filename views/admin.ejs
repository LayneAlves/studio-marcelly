<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <%- include('../includes/head') %>
</head>

<body class="admin-body">
    <div class="admin-panel">
        <%- include('../includes/header') %>

            <%- include('../includes/admin-sidebar') %>

            <main class="admin-content" id="dashboard">
                <section class="admin-dashboard-view" id="dashboardView" aria-labelledby="dashboardTitle">
                    <header class="admin-page-heading dashboard-heading">
                        <div>
                            <p class="admin-eyebrow">Visão geral</p>
                            <h1 id="dashboardTitle">Dashboard</h1>
                            <p>Visão geral do Studio Marcelly Freitas.</p>
                        </div>
                    </header>

                    <section class="dashboard-summary" aria-label="Resumo do studio">
                        <article class="dashboard-summary-card">
                            <span class="dashboard-summary-icon" aria-hidden="true"><i class="fa-regular fa-calendar"></i></span>
                            <div>
                                <p>Agendamentos hoje</p>
                                <strong id="dashboardAppointmentsToday">0</strong>
                            </div>
                        </article>
                        <article class="dashboard-summary-card">
                            <span class="dashboard-summary-icon" aria-hidden="true"><i class="fa-solid fa-wallet"></i></span>
                            <div>
                                <p>Faturamento do mês</p>
                                <strong id="dashboardBillingMonth">R$ 0,00</strong>
                            </div>
                        </article>
                        <article class="dashboard-summary-card">
                            <span class="dashboard-summary-icon" aria-hidden="true"><i class="fa-regular fa-user"></i></span>
                            <div>
                                <p>Clientes</p>
                                <strong id="dashboardClientsCount">0</strong>
                            </div>
                        </article>
                        <article class="dashboard-summary-card">
                            <span class="dashboard-summary-icon" aria-hidden="true"><i class="fa-regular fa-star"></i></span>
                            <div>
                                <p>Serviços ativos</p>
                                <strong id="dashboardActiveServices">0</strong>
                            </div>
                        </article>
                    </section>

                    <section class="dashboard-panel dashboard-upcoming-panel" aria-labelledby="dashboardUpcomingTitle">
                        <header class="dashboard-section-heading">
                            <div>
                                <h2 id="dashboardUpcomingTitle">Próximos agendamentos</h2>
                                <p>Os cinco próximos horários da agenda.</p>
                            </div>
                            <a class="dashboard-section-link" href="#agendamentos">Ver todos <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                        </header>
                        <div class="dashboard-upcoming-list" id="dashboardUpcomingList"></div>
                        <p class="dashboard-empty-state" id="dashboardUpcomingEmpty">Nenhum próximo agendamento.</p>
                    </section>

                    <section class="dashboard-panel dashboard-financial-panel" aria-labelledby="dashboardFinancialTitle">
                        <header class="dashboard-section-heading">
                            <div>
                                <h2 id="dashboardFinancialTitle">Resumo financeiro do mês</h2>
                                <p>Valores calculados a partir dos agendamentos registrados.</p>
                            </div>
                            <a class="dashboard-section-link" href="#faturamento">Ver faturamento <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                        </header>
                        <div class="dashboard-financial-summary">
                            <div class="dashboard-financial-item">
                                <p>Total previsto</p>
                                <strong id="dashboardForecasted">R$ 0,00</strong>
                            </div>
                            <div class="dashboard-financial-item">
                                <p>Total recebido</p>
                                <strong id="dashboardReceived">R$ 0,00</strong>
                            </div>
                            <div class="dashboard-financial-item">
                                <p>Total pendente</p>
                                <strong id="dashboardPending">R$ 0,00</strong>
                            </div>
                        </div>
                    </section>
                    <p class="dashboard-feedback" id="dashboardFeedback" role="status" aria-live="polite"></p>
                </section>

                <section class="admin-appointments" id="agendamentos" hidden aria-labelledby="appointmentsTitle">
                    <div class="admin-page-heading">
                        <div>
                            <p class="admin-eyebrow">Agenda do studio</p>
                            <h1 id="appointmentsTitle">Agendamentos</h1>
                            <p>Visualize e gerencie os atendimentos cadastrados.</p>
                        </div>
                        <button class="admin-button" id="newAppointmentButton" type="button">Novo agendamento</button>
                    </div>
                    <div class="appointment-filters">
                        <div class="appointment-quick-filters" aria-label="Filtros rápidos">
                            <button type="button" data-quick="today">Hoje</button><button type="button"
                                data-quick="tomorrow">Amanhã</button><button type="button" data-quick="week">Esta
                                semana</button><button type="button" data-quick="upcoming">Próximos</button><button
                                type="button" data-quick="completed">Concluídos</button><button type="button"
                                data-quick="cancelled">Cancelados</button>
                        </div>
                        <div class="appointment-filter-fields">
                            <input id="appointmentSearch" type="search"
                                placeholder="Buscar cliente, telefone ou e-mail">
                            <input id="appointmentDateFilter" type="date">
                            <select id="appointmentServiceFilter">
                                <option value="">Todos os serviços</option>
                            </select>
                            <select id="appointmentStatusFilter">
                                <option value="">Todos os status</option>
                                <option value="pending">Pendente</option>
                                <option value="confirmed">Confirmado</option>
                                <option value="in_progress">Em atendimento</option>
                                <option value="completed">Concluído</option>
                                <option value="cancelled">Cancelado</option>
                                <option value="no_show">Não compareceu</option>
                            </select>
                        </div>
                    </div>
                    <div class="appointment-view-controls"><button class="is-active" type="button"
                            data-appointment-view="list">Lista</button><button type="button"
                            data-appointment-view="calendar">Calendário</button></div>
                    <div class="appointment-list-panel" id="appointmentsListView">
                        <div class="appointment-cards" id="appointmentList"></div>
                        <p class="service-empty-state" id="appointmentEmptyState">Nenhum agendamento encontrado.</p>
                    </div>
                    <div class="appointment-calendar" id="appointmentsCalendarView" hidden></div>
                </section>

                <section class="admin-schedule-settings" id="configuracoes-agenda" hidden
                    aria-labelledby="scheduleSettingsTitle">
                    <div class="schedule-settings-header">
                        <button class="schedule-back-button" id="scheduleBackButton" type="button"
                            aria-label="Voltar ao painel"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i></button>
                        <div>
                            <p class="admin-eyebrow">Studio Marcelly Freitas · Administração</p>
                            <h1 id="scheduleSettingsTitle">Configurações da agenda</h1>
                            <p>Defina os dias e horários de funcionamento do atendimento</p>
                        </div>
                    </div>

                    <section class="schedule-card business-hours-card" aria-labelledby="businessHoursTitle">
                        <div class="schedule-card-heading">
                            <span class="schedule-heading-icon"><i class="fa-regular fa-clock" aria-hidden="true"></i></span>
                            <div>
                                <h2 id="businessHoursTitle">Dias e horários de funcionamento</h2>
                                <p>Escolha quais dias a agenda estará disponível e defina os horários.</p>
                            </div>
                        </div>
                        <form id="scheduleSettingsForm">
                            <div class="schedule-days" id="businessHoursList"></div>
                            <p class="schedule-feedback" id="scheduleSettingsFeedback" role="status" aria-live="polite"></p>
                            <div class="schedule-form-actions">
                                <button class="schedule-save-button" type="submit"><i class="fa-solid fa-check"
                                        aria-hidden="true"></i> Salvar configurações</button>
                            </div>
                        </form>
                    </section>

                    <section class="schedule-card manual-blocks-card" aria-labelledby="manualBlocksTitle">
                        <div class="schedule-card-heading">
                            <span class="schedule-heading-icon"><i class="fa-regular fa-clock" aria-hidden="true"></i></span>
                            <div>
                                <h2 id="manualBlocksTitle">Bloqueios manuais</h2>
                                <p>Reserve horários que não devem aparecer como disponíveis para novos agendamentos.</p>
                            </div>
                        </div>
                        <form class="schedule-block-form" id="scheduleBlockForm">
                            <div class="schedule-field"><label for="scheduleBlockDate">Data</label><input
                                    id="scheduleBlockDate" type="date" required></div>
                            <div class="schedule-field"><label for="scheduleBlockStart">Início</label><input
                                    id="scheduleBlockStart" type="time" required></div>
                            <div class="schedule-field"><label for="scheduleBlockEnd">Fim</label><input
                                    id="scheduleBlockEnd" type="time" required></div>
                            <div class="schedule-field schedule-field-reason"><label for="scheduleBlockReason">Motivo
                                    <span>(opcional)</span></label><input id="scheduleBlockReason" type="text"
                                    maxlength="255" placeholder="Ex.: Pausa para almoço"></div>
                            <button class="schedule-secondary-button" type="submit"><i class="fa-solid fa-plus"
                                    aria-hidden="true"></i> Bloquear horário</button>
                        </form>
                        <p class="schedule-feedback" id="scheduleBlockFeedback" role="status" aria-live="polite"></p>
                        <div class="schedule-blocks-heading"><h3>Próximos bloqueios</h3><span id="scheduleBlockCount">0 bloqueios</span></div>
                        <div class="schedule-blocks-list" id="scheduleBlockList"></div>
                        <p class="schedule-blocks-empty" id="scheduleBlockEmptyState">Nenhum bloqueio manual cadastrado.</p>
                    </section>
                </section>

                <section class="admin-billing" id="faturamento" hidden aria-labelledby="billingTitle">
                    <div class="admin-page-heading billing-header">
                        <div>
                            <p class="admin-eyebrow">Financeiro</p>
                            <h1 id="billingTitle">Faturamento</h1>
                            <p>Acompanhe valores recebidos, pendentes e totais por período.</p>
                        </div>
                    </div>

                    <section class="billing-summary" aria-label="Resumo do faturamento">
                        <article class="billing-summary-card"><p>Total previsto</p><strong id="billingForecasted">R$ 0,00</strong></article>
                        <article class="billing-summary-card"><p>Total recebido</p><strong id="billingReceived">R$ 0,00</strong></article>
                        <article class="billing-summary-card"><p>Total pendente</p><strong id="billingPending">R$ 0,00</strong></article>
                        <article class="billing-summary-card"><p>Agendamentos pagos</p><strong id="billingPaidCount">0</strong></article>
                        <article class="billing-summary-card"><p>Agendamentos pendentes</p><strong id="billingPendingCount">0</strong></article>
                    </section>

                    <section class="billing-filters" aria-label="Filtros de faturamento">
                        <div class="billing-period-filters" role="group" aria-label="Selecionar período">
                            <button type="button" data-billing-period="today">Hoje</button>
                            <button type="button" data-billing-period="week">Esta semana</button>
                            <button class="is-active" type="button" data-billing-period="month">Este mês</button>
                            <button type="button" data-billing-period="custom">Personalizado</button>
                        </div>
                        <form class="billing-custom-range" id="billingCustomRange" hidden>
                            <label>Data inicial<input id="billingStartDate" type="date" required></label>
                            <label>Data final<input id="billingEndDate" type="date" required></label>
                            <button class="admin-button" type="submit">Filtrar</button>
                        </form>
                        <p class="billing-feedback" id="billingFeedback" role="status" aria-live="polite"></p>
                    </section>

                    <section class="billing-list" aria-labelledby="billingListTitle">
                        <div class="billing-list-heading"><h2 id="billingListTitle">Registros financeiros</h2><span id="billingPeriodLabel">Este mês</span></div>
                        <div class="billing-table-wrap">
                            <table class="billing-table">
                                <thead><tr><th scope="col">Cliente</th><th scope="col">Serviço</th><th scope="col">Data</th><th scope="col">Valor</th><th scope="col">Sinal</th><th scope="col">Pago</th><th scope="col">Restante</th><th scope="col">Status</th><th scope="col">Ações</th></tr></thead>
                                <tbody id="billingList"></tbody>
                            </table>
                        </div>
                        <p class="service-empty-state" id="billingEmptyState">Nenhum agendamento encontrado neste período.</p>
                    </section>
                </section>

                <section class="admin-services" id="servicos" hidden aria-labelledby="servicesTitle">
                    <div class="admin-page-heading">
                        <div>
                            <p class="admin-eyebrow">Catálogo do studio</p>
                            <h1 id="servicesTitle">Serviços</h1>
                            <p>Cadastre e gerencie os serviços disponíveis para agendamento.</p>
                        </div>
                    </div>

                    <div class="service-form-panel">
                        <h2 id="serviceFormTitle">Cadastrar serviço</h2>
                        <form class="service-form" id="serviceForm">
                            <input type="hidden" id="serviceId">
                            <div class="service-field service-field-wide">
                                <label for="serviceName">Nome do serviço <span aria-hidden="true">*</span></label>
                                <input id="serviceName" name="name" type="text" required maxlength="80"
                                    autocomplete="off" placeholder="Ex.: Volume Brasileiro">
                            </div>
                            <div class="service-field">
                                <label for="serviceValue">Valor <span aria-hidden="true">*</span></label>
                                <input id="serviceValue" name="value" type="text" inputmode="decimal" required
                                    autocomplete="off" placeholder="R$ 0,00">
                            </div>
                            <div class="service-field">
                                <label for="serviceDuration">Duração do serviço <span
                                        aria-hidden="true">*</span></label>
                                <select id="serviceDuration" name="duration" required>
                                    <option value="" selected disabled>Selecione a duração</option>
                                    <option value="15 minutos">15 minutos</option>
                                    <option value="30 minutos">30 minutos</option>
                                    <option value="45 minutos">45 minutos</option>
                                    <option value="1 hora">1 hora</option>
                                    <option value="1 hora e 15 minutos">1 hora e 15 minutos</option>
                                    <option value="1 hora e 30 minutos">1 hora e 30 minutos</option>
                                    <option value="1 hora e 45 minutos">1 hora e 45 minutos</option>
                                    <option value="2 horas">2 horas</option>
                                    <option value="2 horas e 30 minutos">2 horas e 30 minutos</option>
                                    <option value="3 horas">3 horas</option>
                                </select>
                            </div>
                            <div class="service-field">
                                <label for="serviceDeposit">Valor do sinal</label>
                                <input id="serviceDeposit" name="deposit" type="text" inputmode="decimal"
                                    autocomplete="off" placeholder="R$ 0,00">
                            </div>
                            <div class="service-field">
                                <label for="serviceMaintenanceDays">Manutenção recomendada em X dias</label>
                                <input id="serviceMaintenanceDays" name="maintenance_days" type="number" min="1"
                                    max="365" inputmode="numeric" autocomplete="off" placeholder="Ex.: 15">
                            </div>
                            <div class="service-form-actions">
                                <button class="admin-button" id="serviceSubmitButton" type="submit">Cadastrar
                                    serviço</button>
                                <button class="admin-button admin-button-secondary" id="serviceCancelEdit" type="button"
                                    hidden>Cancelar edição</button>
                            </div>
                        </form>
                        <p class="service-feedback" id="serviceFeedback" role="status" aria-live="polite"></p>
                    </div>

                    <div class="service-list-panel">
                        <div class="service-list-heading">
                            <h2>Serviços cadastrados</h2>
                            <span class="service-count" id="serviceCount">0 serviços</span>
                        </div>
                        <div class="service-table-wrap">
                            <table class="service-table">
                                <thead>
                                    <tr>
                                        <th scope="col">Nome do serviço</th>
                                        <th scope="col">Valor</th>
                                        <th scope="col">Duração</th>
                                        <th scope="col">Valor do sinal</th>
                                        <th scope="col">Manutenção</th>
                                        <th scope="col">Status</th>
                                        <th scope="col">Ações</th>
                                    </tr>
                                </thead>
                                <tbody id="serviceList"></tbody>
                            </table>
                        </div>
                        <p class="service-empty-state" id="serviceEmptyState">Nenhum serviço cadastrado ainda.</p>
                    </div>
                </section>

                <section class="admin-appointments admin-maintenance" id="manutencoes" hidden
                    aria-labelledby="maintenancesTitle">
                    <div class="admin-page-heading">
                        <div>
                            <p class="admin-eyebrow">Pós-atendimento</p>
                            <h1 id="maintenancesTitle">Manutenções</h1>
                            <p>Acompanhe os retornos recomendados para cada cliente.</p>
                        </div>
                    </div>
                    <div class="appointment-list-panel">
                        <div class="appointment-cards maintenance-cards" id="maintenanceList"></div>
                        <p class="service-empty-state" id="maintenanceEmptyState">Nenhuma manutenção recomendada no
                            momento.</p>
                    </div>
                </section>
            </main>
    </div>

    <dialog class="appointment-dialog" id="appointmentDialog">
        <div class="appointment-dialog-inner"><button class="dialog-close" id="appointmentDialogClose" type="button"
                aria-label="Fechar">×</button>
            <div id="appointmentDialogContent"></div>
        </div>
    </dialog>

    <%- include('../includes/footer') %>
        <script src="phone-mask.js"></script>
        <script src="admin.js?v=20260926-dashboard"></script>
</body>

</html>

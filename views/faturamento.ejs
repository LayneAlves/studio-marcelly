<!DOCTYPE html>
<html lang="pt-BR"><head><%- include('../includes/head') %></head>
<body class="admin-body" data-admin-module="billing"><div class="admin-panel"><%- include('../includes/header') %><%- include('../includes/admin-sidebar') %>
<main class="admin-content is-admin-view"><section class="admin-billing" aria-labelledby="billingTitle">
    <div class="admin-page-heading billing-header"><div><p class="admin-eyebrow">Financeiro</p><h1 id="billingTitle">Faturamento</h1><p>Acompanhe valores recebidos, pendentes e totais por período.</p></div></div>
    <section class="billing-summary" aria-label="Resumo do faturamento"><article class="billing-summary-card"><p>Total previsto</p><strong id="billingForecasted">R$ 0,00</strong></article><article class="billing-summary-card"><p>Total recebido</p><strong id="billingReceived">R$ 0,00</strong></article><article class="billing-summary-card"><p>Total pendente</p><strong id="billingPending">R$ 0,00</strong></article><article class="billing-summary-card"><p>Agendamentos pagos</p><strong id="billingPaidCount">0</strong></article><article class="billing-summary-card"><p>Agendamentos pendentes</p><strong id="billingPendingCount">0</strong></article></section>
    <section class="billing-filters" aria-label="Filtros de faturamento"><div class="billing-period-filters" role="group" aria-label="Selecionar período"><button type="button" data-billing-period="today">Hoje</button><button type="button" data-billing-period="week">Esta semana</button><button class="is-active" type="button" data-billing-period="month">Este mês</button><button type="button" data-billing-period="custom">Personalizado</button></div><form class="billing-custom-range" id="billingCustomRange" hidden><label>Data inicial<input id="billingStartDate" type="date" required></label><label>Data final<input id="billingEndDate" type="date" required></label><button class="admin-button" type="submit">Filtrar</button></form><p class="billing-feedback" id="billingFeedback" role="status" aria-live="polite"></p></section>
    <section class="billing-list" aria-labelledby="billingListTitle"><div class="billing-list-heading"><h2 id="billingListTitle">Registros financeiros</h2><span id="billingPeriodLabel">Este mês</span></div><div class="billing-table-wrap"><table class="billing-table"><thead><tr><th scope="col">Cliente</th><th scope="col">Serviço</th><th scope="col">Data</th><th scope="col">Valor</th><th scope="col">Sinal</th><th scope="col">Pago</th><th scope="col">Restante</th><th scope="col">Status</th><th scope="col">Ações</th></tr></thead><tbody id="billingList"></tbody></table></div><p class="service-empty-state" id="billingEmptyState">Nenhum agendamento encontrado neste período.</p></section>
</section></main></div><dialog class="appointment-dialog" id="appointmentDialog"><div class="appointment-dialog-inner"><button class="dialog-close" id="appointmentDialogClose" type="button" aria-label="Fechar">×</button><div id="appointmentDialogContent"></div></div></dialog><%- include('../includes/footer') %><script src="/js/admin-shared.js"></script><script src="/js/billing.js"></script></body></html>

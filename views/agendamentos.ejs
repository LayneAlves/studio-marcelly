<!DOCTYPE html>
<html lang="pt-BR"><head><%- include('../includes/head') %></head>
<body class="admin-body" data-admin-module="appointments"><div class="admin-panel"><%- include('../includes/header') %><%- include('../includes/admin-sidebar') %>
<main class="admin-content is-admin-view"><section class="admin-appointments" aria-labelledby="appointmentsTitle">
    <div class="admin-page-heading"><div><p class="admin-eyebrow">Agenda do studio</p><h1 id="appointmentsTitle">Agendamentos</h1><p>Visualize e gerencie os atendimentos cadastrados.</p></div><button class="admin-button" id="newAppointmentButton" type="button">Novo agendamento</button></div>
    <div class="appointment-filters"><div class="appointment-quick-filters" aria-label="Filtros rápidos"><button type="button" data-quick="today">Hoje</button><button type="button" data-quick="tomorrow">Amanhã</button><button type="button" data-quick="week">Esta semana</button><button type="button" data-quick="upcoming">Próximos</button><button type="button" data-quick="completed">Concluídos</button><button type="button" data-quick="cancelled">Cancelados</button></div><div class="appointment-filter-fields"><input id="appointmentSearch" type="search" placeholder="Buscar cliente, telefone ou e-mail"><input id="appointmentDateFilter" type="date"><select id="appointmentServiceFilter"><option value="">Todos os serviços</option></select><select id="appointmentStatusFilter"><option value="">Todos os status</option><option value="pending">Pendente</option><option value="confirmed">Confirmado</option><option value="in_progress">Em atendimento</option><option value="completed">Concluído</option><option value="cancelled">Cancelado</option><option value="no_show">Não compareceu</option></select></div></div>
    <div class="appointment-view-controls"><button class="is-active" type="button" data-appointment-view="list">Lista</button><button type="button" data-appointment-view="calendar">Calendário</button></div>
    <div class="appointment-list-panel" id="appointmentsListView"><div class="appointment-cards" id="appointmentList"></div><p class="service-empty-state" id="appointmentEmptyState">Nenhum agendamento encontrado.</p></div><div class="appointment-calendar" id="appointmentsCalendarView" hidden></div>
</section></main></div>
<dialog class="appointment-dialog" id="appointmentDialog"><div class="appointment-dialog-inner"><button class="dialog-close" id="appointmentDialogClose" type="button" aria-label="Fechar">×</button><div id="appointmentDialogContent"></div></div></dialog>
<%- include('../includes/footer') %><script src="/js/phone-mask.js"></script><script src="/js/admin-shared.js"></script><script src="/js/appointments.js"></script></body></html>

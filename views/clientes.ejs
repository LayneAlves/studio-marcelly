<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <%- include('../includes/head') %>
</head>

<body class="admin-body">
    <div class="admin-panel">
        <%- include('../includes/header') %>
        <button class="admin-sidebar-backdrop" id="clientsBackdrop" type="button" aria-label="Fechar menu"></button>
        <aside class="admin-sidebar" id="clientsSidebar">
            <div class="admin-sidebar-top"><a class="admin-brand" href="index.html"><span
                        class="admin-brand-mark">SM</span><span>Studio <em>Marcelly Freitas</em></span></a>
                <p class="admin-brand-label">Área administrativa</p>
            </div>
            <nav class="admin-menu"><a class="admin-menu-link" href="admin.html#dashboard">Dashboard</a><a
                    class="admin-menu-link" href="admin.html#agendamentos">Agendamentos</a><a class="admin-menu-link"
                    href="admin.html#faturamento">Faturamento</a><a class="admin-menu-link is-active"
                    href="clientes.html" aria-current="page">Clientes</a><a class="admin-menu-link"
                    href="admin.html#servicos">Serviços</a><a class="admin-menu-link"
                    href="admin.html#manutencoes">Manutenções</a><a class="admin-menu-link"
                    href="admin.html#relatorios">Relatórios</a></nav>
            <div class="admin-sidebar-footer"><a class="admin-menu-link admin-logout"
                    href="admin.html#sair">Sair</a></div>
        </aside>
        <main class="admin-content is-admin-view">
            <section class="clients-module" aria-labelledby="clientsTitle">
                <div class="admin-page-heading">
                    <div>
                        <p class="admin-eyebrow">Relacionamento</p>
                        <h1 id="clientsTitle">Clientes</h1>
                        <p>Consulte perfis e o histórico de atendimentos.</p>
                    </div><button class="admin-button" id="newClientButton" type="button">Nova cliente</button>
                </div>
                <div class="clients-toolbar"><input id="clientsSearch" type="search"
                        placeholder="Buscar por nome, telefone ou e-mail"></div>
                <div class="clients-list-panel">
                    <div class="clients-table-wrap">
                        <table class="clients-table">
                            <thead>
                                <tr>
                                    <th>Nome</th>
                                    <th>Telefone</th>
                                    <th>E-mail</th>
                                    <th>Próximo agendamento</th>
                                    <th>Cancelamentos</th>
                                    <th>Faltas</th>
                                    <th>Detalhes</th>
                                </tr>
                            </thead>
                            <tbody id="clientsList"></tbody>
                        </table>
                    </div>
                    <p class="service-empty-state" id="clientsEmptyState">Nenhuma cliente encontrada.</p>
                </div>
            </section>
        </main>
    </div>
    <dialog class="appointment-dialog" id="clientDialog">
        <div class="appointment-dialog-inner"><button class="dialog-close" id="clientDialogClose" type="button"
                aria-label="Fechar">×</button>
            <div id="clientDialogContent"></div>
        </div>
    </dialog>
    <%- include('../includes/footer') %>
    <script src="phone-mask.js"></script>
    <script src="clientes.js"></script>
</body>

</html>

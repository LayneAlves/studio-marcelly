<!DOCTYPE html>
<html lang="pt-BR"><head><%- include('../includes/head') %></head>
<body class="admin-body" data-admin-module="services"><div class="admin-panel"><%- include('../includes/header') %><%- include('../includes/admin-sidebar') %>
<main class="admin-content is-admin-view"><section class="admin-services" aria-labelledby="servicesTitle">
    <div class="admin-page-heading"><div><p class="admin-eyebrow">Catálogo do studio</p><h1 id="servicesTitle">Serviços</h1><p>Cadastre e gerencie os serviços disponíveis para agendamento.</p></div></div>
    <div class="service-form-panel"><h2 id="serviceFormTitle">Cadastrar serviço</h2><form class="service-form" id="serviceForm"><input type="hidden" id="serviceId"><div class="service-field service-field-wide"><label for="serviceName">Nome do serviço <span aria-hidden="true">*</span></label><input id="serviceName" name="name" type="text" required maxlength="80" autocomplete="off" placeholder="Ex.: Volume Brasileiro"></div><div class="service-field"><label for="serviceValue">Valor <span aria-hidden="true">*</span></label><input id="serviceValue" name="value" type="text" inputmode="decimal" required autocomplete="off" placeholder="R$ 0,00"></div><div class="service-field"><label for="serviceDuration">Duração do serviço <span aria-hidden="true">*</span></label><select id="serviceDuration" name="duration" required><option value="" selected disabled>Selecione a duração</option><option value="15 minutos">15 minutos</option><option value="30 minutos">30 minutos</option><option value="45 minutos">45 minutos</option><option value="1 hora">1 hora</option><option value="1 hora e 15 minutos">1 hora e 15 minutos</option><option value="1 hora e 30 minutos">1 hora e 30 minutos</option><option value="1 hora e 45 minutos">1 hora e 45 minutos</option><option value="2 horas">2 horas</option><option value="2 horas e 30 minutos">2 horas e 30 minutos</option><option value="3 horas">3 horas</option></select></div><div class="service-field"><label for="serviceDeposit">Valor do sinal</label><input id="serviceDeposit" name="deposit" type="text" inputmode="decimal" autocomplete="off" placeholder="R$ 0,00"></div><div class="service-field"><label for="serviceMaintenanceDays">Manutenção recomendada em X dias</label><input id="serviceMaintenanceDays" name="maintenance_days" type="number" min="1" max="365" inputmode="numeric" autocomplete="off" placeholder="Ex.: 15"></div><div class="service-form-actions"><button class="admin-button" id="serviceSubmitButton" type="submit">Cadastrar serviço</button><button class="admin-button admin-button-secondary" id="serviceCancelEdit" type="button" hidden>Cancelar edição</button></div></form><p class="service-feedback" id="serviceFeedback" role="status" aria-live="polite"></p></div>
    <div class="service-list-panel"><div class="service-list-heading"><h2>Serviços cadastrados</h2><span class="service-count" id="serviceCount">0 serviços</span></div><div class="service-table-wrap"><table class="service-table"><thead><tr><th scope="col">Nome do serviço</th><th scope="col">Valor</th><th scope="col">Duração</th><th scope="col">Valor do sinal</th><th scope="col">Manutenção</th><th scope="col">Status</th><th scope="col">Ações</th></tr></thead><tbody id="serviceList"></tbody></table></div><p class="service-empty-state" id="serviceEmptyState">Nenhum serviço cadastrado ainda.</p></div>
</section></main></div><dialog class="appointment-dialog" id="appointmentDialog"><div class="appointment-dialog-inner"><button class="dialog-close" id="appointmentDialogClose" type="button" aria-label="Fechar">×</button><div id="appointmentDialogContent"></div></div></dialog><%- include('../includes/footer') %><script src="/js/admin-shared.js"></script><script src="/js/services.js"></script></body></html>
